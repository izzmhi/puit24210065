# Copy this file to ".env" (same folder) and edit it. NEVER commit ".env".
# Real environment variables with the same names override values in this file.

# development | production   (anything unset is treated as production, the safe default)
APP_ENV=development

# Secret "pepper" mixed into every password hash. Server-side only: never put it in the app,
# the database or Git. Must be 32+ characters. Generate one with:  php bin/generate-secret.php
# IMPORTANT: if you change it later, every existing password stops working.
APP_PEPPER=REPLACE_WITH_OUTPUT_OF_generate-secret.php

# --- MySQL (XAMPP / Laragon defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=login_auth
DB_USER=root
DB_PASS=

# Origins allowed to call the API from a browser (exact origins, comma-separated, no "*").
# Expo web dev server runs on :8081; add your Vercel URL when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Two-factor code delivery ---
# dev  = DEVELOPMENT ONLY: the code is returned in the API response so you can demo without email.
#        The server refuses to start with OTP_DELIVERY=dev when APP_ENV=production.
# smtp = the code is emailed using the SMTP settings below (use this for any real deployment).
OTP_DELIVERY=dev

SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (port 587), ssl = implicit TLS (port 465), none = no encryption (development only)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: comma-separated emails that become admin after logging in with password AND emailed code.
# Registering with one of these emails does not give admin by itself.
ADMIN_EMAILS=

# --- Sessions ---
SESSION_TTL_MINUTES=480
# Web sign-in uses an HttpOnly cookie. Secure cookies require HTTPS (localhost is exempt in browsers).
# Default: false in development, true in production.
COOKIE_SECURE=false
# Lax is right when the app and API share a site (localhost, or a Vercel /api proxy).
# Use None (requires COOKIE_SECURE=true) only for a cross-site API on another domain.
COOKIE_SAMESITE=Lax

# Set true ONLY if the API sits behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
