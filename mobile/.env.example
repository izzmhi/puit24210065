# Copy to ".env" in this folder. Variables starting with EXPO_PUBLIC_ are embedded in the app
# and are PUBLIC. Put only the API address here, never secrets.

# Local PHP server on the same computer (browser or iOS simulator):
# EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Physical phone on the same Wi-Fi (use YOUR computer's IPv4 address from `ipconfig`):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api

# Deployed API (HTTPS only):
# EXPO_PUBLIC_API_URL=https://api.your-domain.example/api
